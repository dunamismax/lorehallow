# systemd unit for the Lorehallow game server (BUILD.md 2.9).
# Installed to /etc/systemd/system/ by deploy/bootstrap/host.sh.
# Releases live in /srv/lorehallow/server/releases/<timestamp>/ with a
# `current` symlink that make deploy-server switches atomically.
[Unit]
Description=Lorehallow game server
Documentation=https://github.com/dunamismax/lorehallow/blob/main/docs/ops/runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lorehallow-server
Group=lorehallow-server
WorkingDirectory=/srv/lorehallow/server/current
EnvironmentFile=/etc/lorehallow/server.env
# Production defaults; server.env may override any of them.
Environment=LOREHALLOW_ADDR=127.0.0.1:7420
Environment=LOREHALLOW_ADMIN_ADDR=127.0.0.1:7421
Environment=LOREHALLOW_LOG_FORMAT=json
Environment=LOREHALLOW_TRUST_PROXY=true
Environment=LOREHALLOW_MAP=/srv/lorehallow/server/current/content/maps/starter.tmj
ExecStart=/srv/lorehallow/server/current/lorehallow-server
# SIGTERM starts a graceful shutdown: every player gets Disconnect
# SHUTTING_DOWN and the zone stops (bounded by LOREHALLOW_SHUTDOWN_TIMEOUT).
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=2
# Thousands of connections need thousands of file descriptors.
LimitNOFILE=65536

# Sandboxing: the server only needs to read its release and listen on
# loopback (Caddy terminates TLS in front of it).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

[Install]
WantedBy=multi-user.target
