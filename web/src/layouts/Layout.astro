---
// Every page: head metadata, header, navigation and footer.
import Img from "../components/Img.astro";
import { isoDate, localLongDate } from "../lib/devlog.ts";
import { DRAFTS, ogCard } from "../lib/site.ts";
import { BaseURL, BuildMDURL, CodebergURL, CSS_TOKEN, RepoURL, state } from "../lib/state.ts";

interface Props {
	/** "/progress/". */
	path: string;
	/** "" on the home page. */
	title?: string;
	description: string;
	/** The header link to mark as current. */
	section?: string;
	/** The small line above the title on the share card. */
	kicker?: string;
	/** og:type. */
	type?: string;
	published?: Date;
}

const {
	path,
	title = "",
	description,
	section = "",
	kicker = "Lorehallow",
	type = "website",
	published,
} = Astro.props;
const st = state();
const nav = [
	{ name: "Home", url: "/", section: "home" },
	{ name: "World", url: "/world/", section: "world" },
	{ name: "Progress", url: "/progress/", section: "progress" },
	{ name: "Devlog", url: "/devlog/", section: "devlog" },
	{ name: "Downloads", url: "/downloads/", section: "downloads" },
	{ name: "About", url: "/about/", section: "about" },
];
const cardTitle = title === "" ? "A small pixel-art MMO with a shared world" : title;
const og = BaseURL + ogCard(cardTitle, kicker);
const ogAlt = `Lorehallow: ${cardTitle}. A lantern-lit path through pixel-art hills to a village.`;
const fullTitle =
	title === "" ? "Lorehallow: a small pixel-art MMO with a shared world" : `${title} · Lorehallow`;
const canonical = BaseURL + path;
const short = st.commit.slice(0, 7);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="color-scheme" content="dark">
<meta name="theme-color" content={st.theme.hex("ink")}>
<link rel="preload" href={st.fonts.pixel} as="font" type="font/woff" crossorigin>
<link rel="preload" href={st.fonts.regular} as="font" type="font/woff" crossorigin>
<link rel="stylesheet" href={CSS_TOKEN}>
<link rel="icon" href={st.icons["32"]} sizes="32x32" type="image/png">
<link rel="icon" href={st.icons["16"]} sizes="16x16" type="image/png">
<link rel="icon" href={st.icons["192"]} sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href={st.icons["180"]}>
<link rel="alternate" type="application/rss+xml" title="Lorehallow devlog (RSS)" href="/devlog/rss.xml">
<link rel="alternate" type="application/atom+xml" title="Lorehallow devlog (Atom)" href="/devlog/atom.xml">
<meta property="og:site_name" content="Lorehallow">
<meta property="og:type" content={type}>
<meta property="og:title" content={title === "" ? "Lorehallow" : title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={og}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogAlt}>
{published && <meta property="article:published_time" content={isoDate(published)}>}
<meta name="twitter:card" content="summary_large_image">
<meta name="generator" content={`lorehallow-web ${short}`}>
</head>
<body class={`page-${section === "" ? "plain" : section}`}>
<a class="skip" href="#main">Skip to content</a>
{DRAFTS && <p class="draft-banner">Local preview: draft posts are shown. <code>make web-build</code> leaves them out.</p>}
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Lorehallow home"><Img src="icons/emblem.png" alt="decorative" k={2} eager /><span>Lorehallow</span></a>
    <nav aria-label="Main">
      <ul class="nav">
        {nav.map((n) => <li><a href={n.url} aria-current={n.section === section ? "page" : undefined}>{n.name}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
<main id="main">
<slot />
</main>
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <Img src="icons/emblem.png" alt="decorative" k={2} />
      <p><strong>Lorehallow</strong> is a small pixel-art MMO about a shared world, built in the open.</p>
    </div>
    <nav aria-label="Elsewhere" class="footer-links">
      <ul>
        <li><a href={RepoURL}>Source on GitHub</a></li>
        <li><a href={CodebergURL}>Mirror on Codeberg</a></li>
        <li><a href={BuildMDURL}>The build plan</a></li>
        <li><a href="/devlog/rss.xml">RSS feed</a></li>
        <li><a href="/faq/">FAQ</a></li>
      </ul>
      <ul>
        <li><a href={`${RepoURL}/blob/main/LICENSE`}>Code: AGPL-3.0</a></li>
        <li><a href={`${RepoURL}/blob/main/LICENSE-ART`}>Art and writing: CC BY-NC 4.0</a></li>
        <li><a href="/about/#how-its-made">How it's made</a></li>
      </ul>
    </nav>
    <p class="footer-note">No trackers, no cookies, no scripts. Built from <a href={`${RepoURL}/commit/${st.commit}`}><code>{short}</code></a> on {localLongDate(st.built)}.</p>
  </div>
</footer>
</body>
</html>
