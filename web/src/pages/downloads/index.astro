---
// Downloads, as the Go-built site has it, until /play replaces it (BUILD.md 1.6).
// There are no native builds, so the release list is always empty here.
import { readFileSync } from "node:fs";
import { join } from "node:path";
import Img from "../../components/Img.astro";
import Layout from "../../layouts/Layout.astro";
import { BuildMDURL, state } from "../../lib/state.ts";

const releases = (
	JSON.parse(readFileSync(join(state().web, "data", "releases.json"), "utf8")) as { releases: unknown[] }
).releases;
if (releases.length > 0)
	throw new Error("releases.json: downloads are retired (ADR 0014); use the /play release data");
const platforms = ["Windows", "macOS", "Linux"];
---
<Layout path="/downloads/" title="Downloads" section="downloads" description="Lorehallow builds for Windows, macOS and Linux. Nothing is available yet; follow the progress.">
<section class="page-head">
  <div class="wrap page-head-art">
    <div>
      <p class="kicker">Builds</p>
      <h1>Downloads</h1>
      <p class="lede">There's nothing to download yet. The first playable build ships with Phase 2, when two players can walk around the same small world. <a href="/progress/">Follow the progress</a> to see how close it is.</p>
    </div>
    <Img src="icons/section_icons.png#downloads" alt="decorative" k={4} />
  </div>
</section>
<div class="wrap content">
  <ul class="platforms">
    {platforms.map((name) => (
    <li class="platform unavailable">
      <h2>{name}</h2>
      <p class="status">Not available yet</p>
      <p>No {name} build exists yet. <a href="/progress/">Follow the progress</a>.</p>
    </li>
    ))}
  </ul>
  <div class="prose">
    <h2 id="when">When will there be something?</h2>
    <p>Phase 2 of <a href={BuildMDURL}>the plan</a> ends with the first build anyone can download: two players in one small world, moving around and seeing each other. After that, every phase ships a new version here. Pre-1.0 versions are numbered after their phase, so Phase 2 is v0.2.0.</p>
    <p>Builds will be free, for Windows, macOS and Linux, with a checksum for every file. A browser version comes later, in Phase 15.</p>
  </div>
</div>
</Layout>
