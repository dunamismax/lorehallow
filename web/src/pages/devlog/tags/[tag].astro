---
import PostCard from "../../../components/PostCard.astro";
import Layout from "../../../layouts/Layout.astro";
import { site } from "../../../lib/site.ts";

export async function getStaticPaths() {
	const { tags } = await site();
	return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const { byTag } = await site();
const posts = byTag.get(tag) ?? [];
---
<Layout path={`/devlog/tags/${tag}/`} title={`Devlog: ${tag}`} section="devlog" description={`Lorehallow devlog posts tagged ${tag}.`}>
<section class="page-head">
  <div class="wrap">
    <p class="crumbs"><a href="/devlog/">Devlog</a> / Tags</p>
    <h1>#{tag}</h1>
  </div>
</section>
<div class="wrap content">
  <div class="post-list post-list-3">{posts.map((p) => <PostCard post={p} />)}</div>
  <p><a href="/devlog/">All posts</a></p>
</div>
</Layout>
