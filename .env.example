# Lorehallow server environment variables. Names only; never commit real
# values. Flags override these; see server/README.md.
# In production the env file lives at /etc/lorehallow/server.env.

# Listen address for HTTP and WebSocket traffic. Default 127.0.0.1:7420.
LOREHALLOW_ADDR=
# Log format: text (local default) or json (production).
LOREHALLOW_LOG_FORMAT=
# Log level: debug, info, warn or error. Default info.
LOREHALLOW_LOG_LEVEL=
# Graceful shutdown timeout as a Go duration. Default 20s.
LOREHALLOW_SHUTDOWN_TIMEOUT=
# Zone map, a Tiled .tmj file. Default content/maps/starter.tmj (relative to the working directory).
LOREHALLOW_MAP=
# Loopback address for /metrics and /debug/pprof; empty disables. Default 127.0.0.1:7421. Never public.
LOREHALLOW_ADMIN_ADDR=
# Maximum open game connections. Default 5000.
LOREHALLOW_MAX_CONNECTIONS=
# Maximum unfinished handshakes from one client IP. Default 16.
LOREHALLOW_MAX_PENDING_PER_IP=
# Comma-separated extra browser origins allowed on /ws (for the web build). Default none.
LOREHALLOW_ALLOWED_ORIGINS=
# true behind Caddy: take client IPs from X-Forwarded-For on loopback connections. Default false.
LOREHALLOW_TRUST_PROXY=
