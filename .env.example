# Lorehallow server environment variables. Names only; never commit real
# values. Flags override these; see server/README.md.
# In production the env file lives at /etc/lorehallow/server.env.

# Listen address for HTTP and WebSocket traffic. Default 127.0.0.1:7420.
LOREHALLOW_ADDR=
# Log format: text (local default) or json (production).
LOREHALLOW_LOG_FORMAT=
# Log level: debug, info, warn or error. Default info.
LOREHALLOW_LOG_LEVEL=
# Graceful shutdown timeout as a Go duration. Default 10s.
LOREHALLOW_SHUTDOWN_TIMEOUT=
